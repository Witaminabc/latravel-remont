{
    "name": "teo/admin",
    "description": "Admin panel (vue-router SPA + Sanctum-protected API): pages/posts, media, taxonomies, settings, users, dashboard",
    "type": "laravel-package",
    "license": "MIT",
    "authors": [
        {
            "name": "teo",
            "email": "dev@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "laravel/sanctum": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Teo\\Admin\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Teo\\Admin\\AdminServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
