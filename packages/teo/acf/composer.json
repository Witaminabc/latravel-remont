{
    "name": "teo/acf",
    "description": "Trimmed ACF-like custom fields (repeater, image, text, textarea, ...) for Laravel + Vue 3",
    "type": "laravel-package",
    "license": "MIT",
    "authors": [
        {
            "name": "teo",
            "email": "dev@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Teo\\Acf\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Teo\\Acf\\AcfServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
