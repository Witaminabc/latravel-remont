{
    "name": "teo/chat",
    "description": "Real-time chat package for Laravel with Reverb and Vue 3",
    "type": "laravel-package",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your@email.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "laravel/sanctum": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Teo\\Chat\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Teo\\Chat\\ChatServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
