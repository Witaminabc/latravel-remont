{
    "name": "teo/pages",
    "description": "Public pages via Inertia: templates, SEO (server-rendered meta), ACF field data",
    "type": "laravel-package",
    "license": "MIT",
    "authors": [
        {
            "name": "teo",
            "email": "dev@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "inertiajs/inertia-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Teo\\Pages\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Teo\\Pages\\PagesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}